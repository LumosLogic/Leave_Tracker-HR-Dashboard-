# Database (PostgreSQL — for new deployments)
DATABASE_URL=postgresql://lumos_admin:yourpassword@localhost:5432/lumos_hrms

# Supabase (current — keep until PostgreSQL migration complete)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Centralized Email (SMTP) ──────────────────────────────────────────────────
# One shared SMTP config for all organizations. Per-org SMTP is not supported.
# For Gmail / Google Workspace: use an App Password (16 chars, spaces are stripped automatically).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@lumoslogic.com
SMTP_PASS=                         # Google App Password — 16 chars, no quotes
SMTP_FROM_NAME=Lumos Logic HRMS    # Display name in email From field
SMTP_FROM=                         # Optional: override full From address e.g. "HR Team <hello@lumoslogic.com>"
PLATFORM_ADMIN_EMAIL=

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Clockify
# (stored per-org in organizations table)

# Feature Flags (comma-separated keys to enable globally)
# ENABLED_FEATURES=payroll,expenses,assets

# Biometric IP Allowlist — comma-separated IPs allowed to push data to /iclock/
# Registered device IPs from biometric_devices table are automatically included.
# Add office/VPN/test machine IPs here as a manual override.
# BIOMETRIC_IP_WHITELIST=192.168.1.100,10.0.0.50

# EasyWDMS collector agent API key — must match HRMS_COLLECTOR_KEY in collector/.env
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIC_COLLECTOR_KEY=

# Frontend URL (used in email links)
FRONTEND_URL=https://hrms.lumoslogic.com

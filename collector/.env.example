# ─────────────────────────────────────────────────────────────────────────────
# Lumos HRMS — EasyWDMS Collector Agent Configuration
# Copy this file to .env and fill in all values marked as REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# ── EasyWDMS SQL Server ───────────────────────────────────────────────────────
WDMS_DB_HOST=192.168.0.30          # IP of the Windows machine running SQL Server
WDMS_DB_PORT=1433                  # SQL Server port (default 1433)
WDMS_DB_NAME=EasyWDMS              # Database name (check DataCollector.exe.config)
WDMS_DB_USER=sa                    # SQL Server login
WDMS_DB_PASSWORD=                  # REQUIRED: SQL Server password

# ── Lumos HRMS API ────────────────────────────────────────────────────────────
HRMS_API_URL=https://hrms.lumoslogic.com
HRMS_COLLECTOR_KEY=                # REQUIRED: copy from BIOMETRIC_COLLECTOR_KEY in server .env

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=60000             # Poll every 60 seconds (60000 ms)
BATCH_SIZE=2000                    # Max records fetched per cycle

# ── EasyWDMS Table/Column Names ───────────────────────────────────────────────
# Default values match standard ZKTeco EasyWDMS schema.
# Only change these if your EasyWDMS database uses different names.
#
WDMS_TABLE=att_attlog              # Main attendance log table
WDMS_COL_PIN=USERID               # Employee PIN / enrollment number column
WDMS_COL_TIME=CHECKTIME           # Punch timestamp column
WDMS_COL_TYPE=CHECKTYPE           # Punch type column (0=In, 1=Out)
WDMS_COL_SN=SN                    # Device serial number column

# ── State ─────────────────────────────────────────────────────────────────────
# STATE_FILE=./collector-state.json  # Where to save last sync timestamp
# Default start date is 2026-08-01. To reset, delete collector-state.json.

# EasyWDMS SQL Server connection settings
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Hostname or IP of the machine running SQL Server + EasyWDMS
SQL_HOST=192.168.0.30

# SQL Server port (default 1433; change if using a named instance or custom port)
SQL_PORT=1433

# EasyWDMS database name (almost always "EasyWDMS")
SQL_DATABASE=EasyWDMS

# SQL Server login (DataCollector.exe.config uses "sa")
SQL_USER=sa

# SQL Server password
SQL_PASSWORD=

# Optional: set to "true" to enable mssql verbose debug logging
SQL_DEBUG=false

# Optional: connection timeout in milliseconds (default 15000)
SQL_CONNECT_TIMEOUT=15000

# Optional: query timeout in milliseconds (default 30000)
SQL_REQUEST_TIMEOUT=30000
